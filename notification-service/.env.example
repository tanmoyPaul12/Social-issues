# ============================================================
# Notification Microservice Environment Configuration
# ============================================================
# HOW TO USE:
# 1. Copy this file: Copy-Item .env.example .env  (or `cp .env.example .env`)
# 2. Fill in your SMTP credentials below (or use the test account).
# 3. DO NOT commit your `.env` file to Git!
# ============================================================

PORT=8082

# Redis Broker (Pub/Sub & BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# ────────────────────────────────────────────────────────────
# OPTION 1: Your Personal / Team Gmail Account (Real Inboxes)
# ────────────────────────────────────────────────────────────
# 1. Go to Google Account -> Security -> Enable 2-Step Verification
# 2. Search for "App passwords" -> Create app named "Jharkhand Portal"
# 3. Paste your email and the generated 16-character code below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="Jharkhand Innovation Platform" <your-email@gmail.com>

# ────────────────────────────────────────────────────────────
# OPTION 2: Free Ethereal Test Account (Zero Setup / Instant)
# ────────────────────────────────────────────────────────────
# Uncomment these 5 lines if you don't want to use a real password.
# Ethereal generates clickable email preview links in your terminal.
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=yukl2fhzag7sibrq@ethereal.email
# SMTP_PASS=Z6WSZEK8btTCYDZmDm
# EMAIL_FROM="Jharkhand Innovation Platform" <yukl2fhzag7sibrq@ethereal.email>

# ────────────────────────────────────────────────────────────
# OPTION 3: Brevo / SendGrid / Production Relay
# ────────────────────────────────────────────────────────────
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login@email.com
# SMTP_PASS=your-smtp-master-key
# EMAIL_FROM="Jharkhand Innovation Platform" <your-brevo-login@email.com>

# ────────────────────────────────────────────────────────────
# SMS & WhatsApp Gateways (Optional)
# ────────────────────────────────────────────────────────────
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=JHINOV
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
