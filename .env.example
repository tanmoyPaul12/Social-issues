# Workspace Root Environment Configuration Template

# Frontend Web Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Database Configuration (Supabase PostgreSQL)
DB_HOST=your-db-host.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_URL=jdbc:postgresql://your-db-host:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your-db-password@your-db-host:5432/postgres

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 / S3 Object Storage Configuration
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET_NAME=public-issue
S3_REGION=auto

# Microservices & API Gateway Ports
GATEWAY_PORT=8080
BACKEND_PORT=8081
NOTIFICATION_SERVICE_PORT=8082
AI_SERVICE_PORT=8083
FRONTEND_PORT=3000

# Service URLs for Gateway Routing
BACKEND_SERVICE_URL=http://localhost:8081
BACKEND_URL=http://localhost:8081
NOTIFICATION_SERVICE_URL=http://localhost:8082
AI_SERVICE_URL=http://localhost:8083

# AI Microservice Translation API (NVIDIA NIM & Groq)
TRANSLATION_PROVIDER=nvidia
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_TRANSLATE_MODEL=meta/llama-3.2-11b-vision-instruct

GROK_API_KEY=your_groq_api_key_here
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Nodemailer SMTP Delivery Configuration (Notification Microservice)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="Jharkhand Innovation Portal" <noreply@jhinov.gov.in>

