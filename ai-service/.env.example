# AI Microservice Environment Configuration Template

# Translation API Configuration
TRANSLATION_PROVIDER=nvidia
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_TRANSLATE_MODEL=meta/llama-3.2-11b-vision-instruct
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase PostgreSQL Database Configuration (Step 1 Foundation)
# Option A: Full Connection URI (Recommended for Supabase Transaction/Session pooler)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Option B: Individual Components (Alternative)
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_database_password_here
DB_SSLMODE=require
DB_POOL_MIN=1
DB_POOL_MAX=10
